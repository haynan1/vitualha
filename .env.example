# ─────────────────────────────────────────────────────────────────────────────
# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.
# Tudo que comeca com PUBLIC_ é embutido no HTML final: nao coloque segredo
# aqui. Credencial de deploy vive em GitHub > Settings > Secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Origem de producao. Usada em canonical, hreflang, sitemap, RSS e JSON-LD.
# Barra final é ignorada; caminho, porta ou http derrubam o build.
PUBLIC_SITE_URL=https://vitualha.com

# ── Newsletter (opcional) ────────────────────────────────────────────────────
# URL do formulario do provedor (Buttondown, Beehiiv, Mailchimp...).
# Em branco: o bloco vira um convite para a pagina de contato, sem formulario
# que nao envia para lugar nenhum.
PUBLIC_NEWSLETTER_ACTION=
# Nome do campo de e-mail esperado pelo provedor. Padrao: email
PUBLIC_NEWSLETTER_FIELD=email

# ── Analytics sem cookie (opcional) ──────────────────────────────────────────
# Ex.: https://plausible.io/js/script.js  ou  https://analytics.seu-dominio/script.js
# Ao preencher, libere o dominio em script-src e connect-src no public/.htaccess.
PUBLIC_ANALYTICS_SRC=
PUBLIC_ANALYTICS_ID=

# ── Monetizacao — Google AdSense (opcional) ──────────────────────────────────
# Sem PUBLIC_ADSENSE_CLIENT preenchido, nenhum script de anuncio é carregado e
# nenhum espaco é reservado: o site fica exatamente como é hoje.
#
# O ID do editor aparece no painel do AdSense como "ca-pub-0000000000000000".
# Ele tambem alimenta o /ads.txt, exigido pelo Google para autorizar a venda.
PUBLIC_ADSENSE_CLIENT=

# IDs dos blocos criados no painel (Anuncios > Por unidade de anuncio).
# Cada posicao tem o seu para os relatorios separarem desempenho por lugar.
# Espaco em branco = aquela posicao nao aparece.
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
PUBLIC_ADSENSE_SLOT_ARTICLE_END=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_LISTING=
