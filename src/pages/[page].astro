---
import type { GetStaticPaths } from 'astro';

import { CONTENT_PAGE_KEYS, ROUTE_SEGMENTS, type ContentPageKey } from '@/i18n/routes';
import ContentPageView from '@/views/ContentPageView.astro';

/**
 * Uma rota para todas as paginas institucionais em portugues. O segmento da
 * URL sai do mesmo mapa que gera os links do rodape, entao nao existe a
 * possibilidade de um link apontar para uma rota que nao foi gerada.
 */
export const getStaticPaths: GetStaticPaths = () =>
  CONTENT_PAGE_KEYS.map((key) => ({
    params: { page: ROUTE_SEGMENTS.pt[key] },
    props: { pageKey: key },
  }));

type Props = { pageKey: ContentPageKey };

const { pageKey } = Astro.props;
---

<ContentPageView locale="pt" pageKey={pageKey} />
