---
import { Image } from 'astro:assets';

import { CATEGORIES } from '@/config/categories';
import type { Article } from '@/lib/articles';

type Props = {
  article: Article;
  sizes: string;
  widths: number[];
  /** Apenas a capa do artigo em destaque acima da dobra deve ser eager. */
  eager?: boolean;
  ratio?: string;
};

const { article, sizes, widths, eager = false, ratio = '16 / 10' } = Astro.props;
const { cover, coverAlt, category } = article.entry.data;
const meta = CATEGORIES[category];
---

<div class="cover" style={`--ratio: ${ratio}; --hue: ${meta.hue};`}>
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding={eager ? 'sync' : 'async'}
        class="cover__img"
      />
    ) : (
      /**
       * Sem capa, o artigo ainda precisa de presenca visual. O gradiente vem
       * do matiz da categoria, entao a grade fica coerente e o leitor
       * identifica o assunto pela cor antes de ler o titulo.
       */
      <div class="cover__fallback" aria-hidden="true">
        <span class="cover__letter">{meta.letter}</span>
      </div>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
  }

  .cover__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .cover__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 120% at 12% 8%, hsl(var(--hue) 46% 46% / 0.95), transparent 62%),
      linear-gradient(142deg, hsl(var(--hue) 38% 30%), hsl(calc(var(--hue) + 18) 44% 18%));
  }

  .cover__letter {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 1.5rem + 8vw, 6rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }
</style>
