---
import type { Locale } from '@/i18n/locales';
import { t } from '@/i18n/ui';

type Props = { locale: Locale; url: string; title: string };

const { locale, url, title } = Astro.props;
const ui = t(locale);

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

/**
 * Links de compartilhamento sao ancoras normais: funcionam sem JavaScript e
 * nao carregam nenhum widget de terceiro (que traria rastreamento junto).
 */
const targets = [
  {
    name: 'WhatsApp',
    href: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    path: 'M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3.1.8.8-3-.2-.3A8 8 0 1 1 12 20zm4.4-5.8c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.7 1-.3.2-.5.1a6.5 6.5 0 0 1-1.9-1.2 7.3 7.3 0 0 1-1.3-1.7c-.1-.2 0-.4.1-.5l.4-.4.2-.4v-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8 8.6 8.6 0 0 0 2.5.7 2.4 2.4 0 0 0 1.6-.5 2 2 0 0 0 .6-1.3v-.5z',
  },
  {
    name: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    path: 'M6.94 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM3.2 8.5h3.5V21H3.2V8.5zm5.9 0h3.35v1.7h.05a3.67 3.67 0 0 1 3.3-1.82c3.53 0 4.2 2.33 4.2 5.35V21h-3.5v-6.4c0-1.53-.03-3.5-2.13-3.5s-2.46 1.66-2.46 3.38V21H9.1V8.5z',
  },
  {
    name: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    path: 'M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z',
  },
  {
    name: 'X',
    href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    path: 'M17.6 3h3.1l-6.8 7.8L22 21h-6.3l-4.9-6.4L5.1 21H2l7.3-8.3L2 3h6.4l4.4 5.9L17.6 3zm-1.1 16.1h1.7L7.6 4.8H5.8l10.7 14.3z',
  },
];
---

<div class="share" data-share>
  <span class="share__label">{ui.article.shareTitle}</span>

  <ul class="share__list">
    {
      targets.map((target) => (
        <li>
          <a
            class="icon-btn"
            href={target.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${ui.article.shareTitle} — ${target.name}`}
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={target.path} />
            </svg>
          </a>
        </li>
      ))
    }
    <li>
      <button
        type="button"
        class="icon-btn"
        data-copy-link={url}
        aria-label={ui.article.copyLink}
        data-copied-label={ui.article.linkCopied}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M10 13.5a3.5 3.5 0 0 0 5 0l3-3a3.5 3.5 0 0 0-5-5l-1 1"></path>
          <path d="M14 10.5a3.5 3.5 0 0 0-5 0l-3 3a3.5 3.5 0 0 0 5 5l1-1"></path>
        </svg>
      </button>
    </li>
  </ul>

  <p class="share__status" role="status" aria-live="polite" data-copy-status></p>
</div>

<style>
  .share {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .share__label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .share__list {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .share__list svg {
    width: 17px;
    height: 17px;
  }

  .share__status {
    font-size: var(--text-xs);
    color: var(--primary);
  }
</style>

<script>
  /**
   * Copiar link exige JavaScript por natureza; o resto da barra nao. O aviso
   * vai para um live region para quem usa leitor de tela tambem receber a
   * confirmacao.
   */
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-link]')) {
    // O aviso é o da propria barra: a pagina tem duas (lateral e rodape do
    // artigo), e a confirmacao precisa aparecer onde o leitor clicou.
    const status = button.closest('[data-share]')?.querySelector<HTMLElement>('[data-copy-status]');

    button.addEventListener('click', async () => {
      const url = button.dataset['copyLink'];
      if (!url || !navigator.clipboard) return;

      try {
        await navigator.clipboard.writeText(url);
        if (status) {
          status.textContent = button.dataset['copiedLabel'] ?? '';
          window.setTimeout(() => {
            status.textContent = '';
          }, 2600);
        }
      } catch {
        /* Permissao negada: o leitor ainda pode copiar da barra de endereco. */
      }
    });
  }
</script>
